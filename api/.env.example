# Copy to api/.env and fill in.

# Which model runs the agents: gemini (free key) or claude (paid API key).
LLM_PROVIDER=gemini

# Gemini API key: create a free one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Only if LLM_PROVIDER=claude (https://console.anthropic.com; separate from a Claude subscription).
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Signs session cookies and OAuth state. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Gmail sending: users click "Connect Gmail" and approve on Google's page (see README).
# Authorized redirect URI: http://localhost:3000/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Online deployment (see README "Deploying"); leave empty for local development.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# ENCRYPTION_KEY=   # required online: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Optional
# FRONTEND_URL=http://localhost:3000
# ALLOW_SIGNUPS=false          # true lets more people create accounts
# COOKIE_SECURE=true   # set when served over HTTPS
